# Copy this file to .env.local and fill in the values. See the README.
#
# Everything here is loaded by Vite and ends up in the browser bundle, so treat
# it as public — with one exception, the debug token at the bottom.

# From: firebase apps:sdkconfig WEB
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# From: firebase appcheck:debugtokens:create --app <appId> --display-name local-dev
#
# This one IS a secret: anyone holding it can pass App Check as your app. It is
# only read during `npm run dev` and never reaches a production build.
VITE_APPCHECK_DEBUG_TOKEN=
